{
  "appId": "com.funbungames.coloursort",
  "appName": "Colour Sort",
  "webDir": "www",
  "ios": {
    "contentInset": "never",
    "backgroundColor": "#191c35",
    "scheme": "ColourSort"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 600,
      "backgroundColor": "#191c35",
      "showSpinner": false
    },
    "NativePurchases": {
      "autoFinishTransactions": true
    }
  }
}
